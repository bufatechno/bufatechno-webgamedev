# # BUFATECHNO WEB GAME DEV — .gitignore for ZCode (z.ai) & Claude Code skills
# # Focus: ONLY ZCode (https://zcode.z.ai) + Claude Code (https://code.claude.com) — not OpenCode.
# # Ref: ZCode Skill https://zcode.z.ai/en/docs/skill | Claude Skill https://code.claude.com/docs/en/skills
# # IMPORTANT npm: do not create .npmignore! This project uses `files` in package.json (allowlist).
# # If .npmignore is created, it will OVERRIDE .gitignore during `npm publish` and may leak .env/.claude cache (Claude Code incident 2026).

# Dependencies
node_modules/
# Lockfile MUST be committed for npm skill (deterministic). Do not ignore.
# If you really do not want it, uncomment manually:
# package-lock.json
# yarn.lock
# pnpm-lock.yaml
# bun.lockb

# Build outputs (Vite / skill)
dist/
build/
out/
.output/
.vite/
.next/
.nuxt/
.cache/
*.tsbuildinfo

# Environment variables (do not publish)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.log

# Coverage & Test
coverage/
.nyc_output/
junit.xml

# OS files
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Editor / IDE (keep .vscode uncommitted for skill)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.c9/
*.launch
.settings/

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Vite
vite.config.*.timestamp-*

# --- Skill ZCode (z.ai) & Claude — local configs (DO NOT commit) ---
# ZCode (official zcode.z.ai/docs/skill):
#   User-level: ~/.zcode/skills/<name>/SKILL.md  (global, all workspaces)
#   Workspace-level: <workspace>/.zcode/skills/<name>/SKILL.md  (project only)
#   Also: ~/.zcode/commands/, ~/.zcode/agents/, ~/.zcode/cli/config.json
.zcode/
# Claude Code (code.claude.com/docs/skills):
#   Personal: ~/.claude/skills/<name>/SKILL.md  (global)
#   Project: .claude/skills/<name>/SKILL.md  (team, commit to repo if needed)
#   Also: .claude/settings.local.json (do not commit)
.claude/

# Other tools (NOT ZCode z.ai) — only ignored to avoid committing during local dev, not distribution target:
# OpenCode (anomalyco/opencode) ≠ ZCode (z.ai) — paths: .opencode/skills/, ~/.config/opencode/skills/
.opencode/
.agents/
.codex/

# --- Scaffold output — game generated by skill (local test only, DO NOT commit) ---
my-game/
my-babylon-game/
game/
test-scaffold/
test-game/
scaffold-test/
playground/
demo-game/
*.splat
*.ply
*.spz
*.sog

# npm publish artifact (do not commit tarball)
*.tgz
*.tar.gz

# IMPORTANT: Core skill files MUST remain committed (SKILL.md, README.md, INSTALL.md, CHANGELOG.md, LICENSE, references/, scripts/, assets/, package.json)
# All rules above are safe — none ignore those core files.
# Verify: `git check-ignore -v SKILL.md` must be empty, `npm pack --dry-run` must list 36 files.
